{
  "name": "@varuna/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db:bootstrap": "tsx src/db/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "lint": "eslint src",
    "ais:import": "tsx src/modules/ais/import-cli.ts",
    "attribute": "tsx src/modules/attribution/pipeline-cli.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "@node-rs/argon2": "^2.0.2",
    "@turf/turf": "^7.2.0",
    "bullmq": "^5.34.10",
    "jose": "^5.9.6",
    "socket.io": "^4.8.1",
    "@varuna/shared": "workspace:*",
    "geographiclib-geodesic": "^2.1.1",
    "dotenv": "^16.4.7",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^5.4.2",
    "mongoose": "^8.9.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/geojson": "^7946.0.15",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  },
  "exports": {
    "./src/*": "./src/*"
  }
}
